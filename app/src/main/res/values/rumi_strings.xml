  Rumi overrides of upstream Element X strings. The app module wins Android resource merging over
  feature libraries, so these replace the upstream copy without touching localazy.xml (keeps
  upstream syncs conflict-free). Only strings that leak Element/Matrix branding to teachers go here.
-->
<resources>
    <!-- Login password screen subtitle; upstream says "Matrix is an open network ..." -->
    <string name="screen_login_subtitle">"A private messenger for your school team."</string>
    <!-- Notification settings, default message sound label; upstream says "Element Default" -->
    <string name="screen_notification_settings_sound_element_default">"Rumi Default"</string>
</resources>
